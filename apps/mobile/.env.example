# PS-089 Mobile Client Configuration Example
# Copy this file to .env and configure with your Supabase Project settings.
# Run with: flutter run --dart-define-from-file=.env

# Supabase Project URL (Client safe)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Public Key (Client safe)
SUPABASE_ANON_KEY=your-anon-key-here

# Environment Mode (development | staging | production)
APP_ENVIRONMENT=development
